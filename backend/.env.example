# Host & Port (Render/Railway automatically set PORT)
HOST=0.0.0.0
PORT=8000

# Assistant Custom Name (e.g. SecureVision AI, JARVIS, Nova)
ASSISTANT_NAME=SecureVision AI

# Google Gemini API Key (Can also be set dynamically via Extension UI)
GEMINI_API_KEY=

# Gemini Model (e.g. gemini-3.5-flash-lite, gemini-3.5-flash)
GEMINI_MODEL=gemini-3.5-flash-lite
