# ========================================================
# SECUREVISION AI - Environment Configuration
# HackIndia AI & CyberTech Hackathon 2026
# ========================================================

# Server Configuration
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO

# AI Provider ("gemini" | "openai" | "mock")
LLM_PROVIDER=gemini

# Google Gemini API Key (Backend Only - NEVER exposed to frontend or extension)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (Optional fallback)
OPENAI_API_KEY=your_openai_api_key_here

# Zero-Leakage Privacy Settings
STRICT_PII_GUARD=true
MAX_REQUEST_SIZE_MB=10
FAIL_CLOSED_GATE=true
