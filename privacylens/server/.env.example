# Backend-only settings. Never copy these secrets into the frontend .env.
LLM_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OLLAMA_ENDPOINT=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2-vl

# Local dashboard origins. Add the deployed Vercel URL in Render's environment.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
