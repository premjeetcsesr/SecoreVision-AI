# PrivacyLens Backend Configuration
# Pluggable Provider: "mock", "gemini", or "ollama"
LLM_PROVIDER=mock

# Google Gemini Settings (optional if using mock or ollama)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Ollama Settings (for offline open-weights models like Qwen2-VL or Llama 3.2 Vision)
OLLAMA_ENDPOINT=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2-vl

# Server Network Settings
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=info
