# =====================================================================
# Privacy-Preserving Vision Agent & Chitty Assistant Configuration
# Unified Environment Settings (Jarvis Automation + Privacy Agent)
# =====================================================================

# ---------------------------------------------------------------------
# 1. Server Configuration
# ---------------------------------------------------------------------
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=info

# ---------------------------------------------------------------------
# 2. LLM / AI Reasoning Engine (Local llama.cpp / vLLM / OpenAI API)
# ---------------------------------------------------------------------
# OpenAI-compatible local or remote endpoint (e.g., llama.cpp, vLLM, Ollama)
LLM_BASE_URL=http://127.0.0.1:8080/v1
LLM_API_KEY=local-no-key
LLM_MODEL=qwen-local
LLM_CONTEXT_SIZE=65536

# Model Profile: auto, compact, or full
MODEL_PROFILE=auto

# Optional Cloud VLM Keys (Gemini & OpenAI)
GEMINI_API_KEY=
OPENAI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# ---------------------------------------------------------------------
# 3. Speech-To-Text (STT) Configuration
# ---------------------------------------------------------------------
STT_URL=http://127.0.0.1:8000/v1/audio/transcriptions
STT_MODEL=mlx-community/whisper-small-mlx-q4
STT_ENGINE=web-speech-api-with-backend-stt

# ---------------------------------------------------------------------
# 4. Text-To-Speech (TTS) Configuration
# ---------------------------------------------------------------------
TTS_URL=http://127.0.0.1:8000/v1/audio/speech
TTS_PROVIDER=qwen3-tts
TTS_MODEL=mlx-community/Qwen3-TTS-12Hz-1.7B-CustomVoice-6bit
TTS_VOICE=Ryan
TTS_LANG_CODE=English
TTS_TEMPERATURE=0.35
TTS_TOP_P=0.90
TTS_TOP_K=20
TTS_REPETITION_PENALTY=1.10
TTS_SPEED=1.0
TTS_STREAMING_INTERVAL=0.32
TTS_INSTRUCT="Neutral, clear speech, steady pacing."
TTS_ENGINE=web-speech-synthesis-with-backend-tts

# ---------------------------------------------------------------------
# 5. Browser Automation & Agent Workspace Sandbox (Jarvis Engine)
# ---------------------------------------------------------------------
# Agent file operations are strictly constrained to this directory
AGENT_WORKSPACE=./workspace
BROWSER_PROFILE=./data/browser-profile
BROWSER_HEADLESS=true
BROWSER_USER=agent
BROWSER_PASSWORD=change-me
BROWSER_CDP_URL=http://127.0.0.1:9223

# Domain Allowlist: comma-separated domains allowed for navigation (* allows all)
BROWSER_ALLOWLIST=*

# ---------------------------------------------------------------------
# 6. Security & Privacy Settings
# ---------------------------------------------------------------------
# Enforce Zero-Leakage server audit verification (True / False)
ENFORCE_ZERO_LEAKAGE_AUDIT=True
